{
  "name": "smartstore",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "modules/smartstore/src",
  "projectType": "library",
  "tags": ["scope:module", "domain:smartstore"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/modules/smartstore",
        "main": "modules/smartstore/src/index.ts",
        "tsConfig": "modules/smartstore/tsconfig.lib.json",
        "assets": ["modules/smartstore/*.md"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "modules/smartstore/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    }
  },
  "implicitDependencies": ["shared-types", "shared-llm"]
}

